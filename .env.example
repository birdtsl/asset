# TSL Smart Asset — Environment Variables Example

APP_NAME="TSL Smart Asset"
APP_URL="http://localhost:3000"
TZ="Asia/Bangkok"

# Database (MariaDB) — use only tsl_asset
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/tsl_asset?charset=utf8mb4"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-strong-secret"
AUTH_TRUST_HOST="true"

# Local file storage root
STORAGE_ROOT="./storage"

# Shared login with ERP TSL (HOSxP opduser) — same host DB as erptsl
# HOSXP_DATABASE_URL="mysql://USER:PASSWORD@192.168.1.252:3306/h11250?charset=utf8mb4"
# HOSXP_AUTH_ENABLED="true"
# HOSXP_DEFAULT_ROLE="VIEWER"
# DATABASE_TEXT_ENCODING="tis620"

# Optional — enables LLM answers in AI Assistant (otherwise FAQ + live KPIs)
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Desktop sync agent (Excel chek → API delta). Generate a long random string.
# SYNC_AGENT_API_KEY="change-me-to-a-long-random-secret"
